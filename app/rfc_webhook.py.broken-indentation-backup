def _dedupe_key(instance: str, remote_jid: str, requester: str, query: str, msg_id: str) -> str:
    base = f"{instance}|{remote_jid}|{requester}|{query or msg_id}"
    return hashlib.sha1(base.encode("utf-8")).hexdigest()


@router.post("/webhook/evolution-rfc")
async def evolution_rfc_webhook(request: Request):
    """
    Webhook RFC grupo02:
    - Solo atiende grupos (@g.us)
    - Privados se ignoran completamente
    - /groupid responde el ID del grupo
    - /addgroup autoriza el grupo
    - Solicitudes válidas se encolan al worker
    """
    try:
        payload = await request.json()
    except Exception:
        return {"ok": False, "error": "invalid_json"}

    db = SessionLocal()

    event = (payload.get("event") or payload.get("type") or "").strip()
    instance = (payload.get("instance") or payload.get("instanceName") or "grupo02").strip()

    if event and event not in ("messages.upsert", "MESSAGES_UPSERT", "messages_upsert"):
        return {"ok": True, "ignored": "event", "event": event}

    data = payload.get("data") or {}
    key = data.get("key") or {}

    # Ignorar mensajes enviados por el propio bot
    if key.get("fromMe") is True:
        return {"ok": True, "ignored": "from_me"}

    remote_jid = (
        key.get("remoteJid")
        or data.get("remoteJid")
        or data.get("chatId")
        or ""
    ).strip()

    participant = (
        key.get("participant")
        or data.get("participant")
        or data.get("sender")
        or ""
    ).strip()

    msg_id = (
        key.get("id")
        or data.get("id")
        or data.get("messageId")
        or ""
    ).strip()

    push_name = (
        data.get("pushName")
        or data.get("pushname")
        or data.get("notifyName")
        or "Cliente"
    )

    message = data.get("message") or {}

    text_body = (
        message.get("conversation")
        or message.get("extendedTextMessage", {}).get("text")
        or message.get("imageMessage", {}).get("caption")
        or message.get("documentMessage", {}).get("caption")
        or data.get("text")
        or data.get("body")
        or ""
    )

    text_body = str(text_body or "").strip()

    group_jid = remote_jid
    requester_number = participant or remote_jid

    print("RFC_WEBHOOK_IN =", {
        "event": event,
        "instance": instance,
        "remote_jid": remote_jid,
        "participant": participant,
        "msg_id": msg_id,
        "text": text_body[:120],
    }, flush=True)

    # ==========================================================
    # REGLA PRINCIPAL: ESTE BOT SOLO FUNCIONA EN GRUPOS
    # ==========================================================
    if not remote_jid.endswith("@g.us"):
        print("RFC_PRIVATE_IGNORED =", {
            "remote_jid": remote_jid,
            "participant": participant,
            "text": text_body[:80],
        }, flush=True)
        return {"ok": True, "ignored": "private_chat"}

    cmd = text_body.lower().strip()

    # ==========================================================
    # /groupid: responder ID del grupo
    # ==========================================================
    if cmd in ("/groupid", "groupid", "/idgrupo", "idgrupo", "/id"):
        try:
            send_text(
                instance,
                group_jid,
                f"🆔 ID del grupo:\n{group_jid}\n\nInstancia: {instance}"
            )
        except Exception as e:
            print("RFC_GROUPID_SEND_ERROR =", repr(e), flush=True)

        print("RFC_GROUPID_OK =", {"group_jid": group_jid, "instance": instance}, flush=True)
        return {"ok": True, "groupid": group_jid, "instance": instance}

    # ==========================================================
    # /addgroup: autorizar grupo
    # ==========================================================
    if cmd in ("/addgroup", "addgroup", "/autorizar", "autorizar"):
        try:
            row = db.query(AuthorizedGroup).filter(AuthorizedGroup.group_jid == group_jid).first()

            if not row:
                row = AuthorizedGroup(
                    group_jid=group_jid,
                    group_name=group_jid,
                    owner_instance=instance,
                    is_hidden=False,
                    hidden_in_main=False,
                )
                db.add(row)
            else:
                row.owner_instance = instance
                row.is_hidden = False
                row.hidden_in_main = False
                if not row.group_name:
                    row.group_name = group_jid

            db.commit()

            try:
                send_text(
                    instance,
                    group_jid,
                    "✅ Grupo autorizado para RFC.\n\n"
                    "Ya pueden enviar:\n"
                    "• CURP\n"
                    "• RFC\n"
                    "• RFC + IDCIF\n"
                    "• QR SAT"
                )
            except Exception as e:
                print("RFC_ADDGROUP_SEND_ERROR =", repr(e), flush=True)

            print("RFC_ADDGROUP_OK =", {"group_jid": group_jid, "instance": instance}, flush=True)
            return {"ok": True, "addgroup": True, "group_jid": group_jid, "instance": instance}

        except Exception as e:
            db.rollback()
            print("RFC_ADDGROUP_ERROR =", repr(e), flush=True)
            try:
                send_text(instance, group_jid, "❌ No pude autorizar este grupo. Revisa logs.")
            except Exception:
                pass
            return {"ok": False, "error": "addgroup_failed"}

    # ==========================================================
    # Validar que el grupo esté autorizado
    # ==========================================================
    group_row = (
        db.query(AuthorizedGroup)
        .filter(
            AuthorizedGroup.group_jid == group_jid,
        )
        .first()
    )

    if not group_row:
        print("RFC_GROUP_NOT_AUTHORIZED =", {"group_jid": group_jid, "instance": instance}, flush=True)
        return {"ok": True, "ignored": "group_not_authorized", "group_jid": group_jid}

    # ==========================================================
    # Detectar tipo de solicitud
    # ==========================================================
    src = text_body.upper()

    curp_match = CURP_RE.search(src) if "CURP_RE" in globals() else None
    rfc_match = RFC_RE.search(src) if "RFC_RE" in globals() else None
    idcif_match = IDCIF_RE.search(src) if "IDCIF_RE" in globals() else None

    msg_type = "text"
    query = ""

    if curp_match:
        msg_type = "CURP"
        query = curp_match.group(0).upper()
    elif rfc_match and idcif_match:
        msg_type = "RFC_IDCIF"
        query = f"{rfc_match.group(0).upper()} {idcif_match.group(0)}"
    elif rfc_match:
        msg_type = "RFC_ONLY"
        query = rfc_match.group(0).upper()
    else:
        # Solo en grupos autorizados respondemos inválido.
        try:
            send_text(
                instance,
                group_jid,
                "⚠️ No detecté una solicitud válida.\n\n"
                "Puedes enviar:\n"
                "• CURP\n"
                "• RFC\n"
                "• RFC + IDCIF\n"
                "• QR del SAT en imagen"
            )
        except Exception as e:
            print("RFC_INVALID_SEND_ERROR =", repr(e), flush=True)

        return {"ok": True, "ignored": "invalid_request"}

    # ==========================================================
    # Dedupe básico por mensaje
    # ==========================================================
    dedupe_key = f"rfc:inflight:{instance}:{group_jid}:{msg_id or query}"
    try:
        ok = redis_conn.set(dedupe_key, "1", nx=True, ex=60 * 10)
        if not ok:
            print("RFC_DUPLICATE_IGNORED =", dedupe_key, flush=True)
            return {"ok": True, "ignored": "duplicate"}
    except Exception as e:
        print("RFC_DEDUPE_ERROR =", repr(e), flush=True)

    # ACK al grupo
    try:
        send_text(
            instance,
            group_jid,
            f"🚀 RFC GRUPO02\nSolicitud recibida de {push_name}.\nEsto puede tardar unos minutos..."
        )
    except Exception as e:
        print("RFC_ACK_SEND_ERROR =", repr(e), flush=True)

    job_data = {
        "requester_number": requester_number,
        "requester_name": push_name,
        "group_jid": group_jid,
        "group_name": getattr(group_row, "group_name", None) or group_jid,
        "original_text": text_body,
        "query": query,
        "msg_type": msg_type,
        "msg_id": msg_id,
        "evolution_instance": instance,
    }

    request_queue.enqueue(
        "worker_jobs.process_group_request_job",
        job_data,
        job_timeout=900,
        result_ttl=3600,
        failure_ttl=86400,
    )

    print("RFC_JOB_QUEUED =", job_data, flush=True)

    return {
        "ok": True,
        "queued": True,
        "type": msg_type,
        "instance": instance,
        "group_jid": group_jid,
    }

